name=input("Student Name: ")
marks=[]
for i in range(5):
    mark=float(input(f"Enter mark {i+1}: "))
    marks.append(mark)
total=sum(marks)
average=total/5
if average>=90:
    grade="A+"
elif average>=80:
    grade = "A"
elif average>=70:
    grade = "B"
elif average>=60:
    grade="C"
else:
    grade="F"
print("\n--- RESULT ---")
print("Student:",name)
print("Total:",total)
print("Average:",average)
print("Grade:",grade)
